{
  "name": "Employee",
  "type": "object",
  "properties": {
    "full_name": { "type": "string", "description": "שם מלא" },
    "id_number": { "type": "string", "description": "תעודת זהות" },
    "phone": { "type": "string", "description": "טלפון" },
    "email": { "type": "string", "description": "אימייל" },
    "role": { "type": "string", "enum": ["manager", "cashier", "fueling_attendant", "maintenance", "security"], "description": "תפקיד" },
    "station_id": { "type": "string", "description": "תחנה משויכת" },
    "status": { "type": "string", "enum": ["active", "inactive", "on_leave"], "default": "active", "description": "סטטוס עובד" },
    "start_date": { "type": "string", "format": "date", "description": "תאריך תחילת עבודה" },
    "hourly_rate": { "type": "number", "description": "שכר לשעה" },
    "notes": { "type": "string", "description": "הערות" }
  },
  "required": ["full_name", "role"]
}
