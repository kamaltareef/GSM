{
  "name": "ChargingSession",
  "type": "object",
  "properties": {
    "station_id": { "type": "string" },
    "charging_station_id": { "type": "string", "description": "מזהה עמדת טעינה" },
    "vehicle_plate": { "type": "string" },
    "customer_name": { "type": "string" },
    "customer_email": { "type": "string" },
    "energy_delivered_kwh": { "type": "number", "description": "אנרגיה שנטענה בקוט״ש" },
    "price_per_kwh": { "type": "number" },
    "total_amount": { "type": "number" },
    "status": { "type": "string", "enum": ["waiting", "charging", "completed", "cancelled", "error"], "default": "waiting" },
    "charge_percent_start": { "type": "number" },
    "charge_percent_end": { "type": "number" },
    "start_time": { "type": "string", "format": "date-time" },
    "end_time": { "type": "string", "format": "date-time" }
  },
  "required": ["station_id", "charging_station_id"]
}
